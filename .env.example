# Copy to .env.local. Never send or commit your key.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DIRECTOR_PROVIDER=deepseek
DIRECTOR_MODEL=deepseek-flash
DIRECTOR_BASE_URL=https://api.deepseek.com
IMAGE_MODEL=qwen/qwen-image-2.1-turbo
IMAGE_RESOLUTION=2K
VIDEO_MODEL=heygen/heygen-video-1
VIDEO_RESOLUTION=480p
# Optional for V2 image-to-video: your own private S3-compatible bucket.
# R2: set REGION=auto and ENDPOINT=https://<account>.r2.cloudflarestorage.com
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_PREFIX=story-agent
MEDIA_S3_FORCE_PATH_STYLE=false
# OpenRouter must be an ordinary inference key, not a management/provisioning key.
# Optional OpenRouter director: set DIRECTOR_PROVIDER=openrouter, model to
# deepseek/deepseek-v4.1-flash-1017 and base URL to https://openrouter.ai/api/v1.
PORT=4310
# Defaults: ./data/live (normal), ./data/demo (demo). Keep separate data roots.
# STORY_AGENT_DATA_DIR=./data/live
# Optional: a local FFmpeg executable; bundled ffmpeg-static is the default.
# FFMPEG_PATH=
