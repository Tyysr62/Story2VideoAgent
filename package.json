{
  "name": "story-agent",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx src/server/main.ts",
    "demo": "node --import tsx src/server/main.ts --demo",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@fastify/static": "8.3.0",
    "dotenv": "17.2.3",
    "fastify": "5.6.2",
    "ffmpeg-static": "5.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.35.5",
    "typebox": "1.3.27",
    "yazl": "3.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "5.0.4",
    "fflate": "0.8.3",
    "node": "22.23.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
